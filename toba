    /* OLX-FIGHTER-BACKGROUND-V3 / START
       Full integration: the original content, links and effects are unchanged.
       Flights use transform/opacity only. No custom JavaScript is required.
       The flight container is fixed and cannot increase document height. */
    .olx-airspace {
      position: fixed;
      inset: 0;
      z-index: 2;
      display: block;
      overflow: hidden;
      pointer-events: none;
      user-select: none;
      isolation: isolate;
    }
    .olx-airspace * { pointer-events: none; }
    .olx-jet-flight {
      position: absolute;
      left: 0;
      width: 190px;
      height: 114px;
      opacity: 1;
      will-change: transform, opacity;
      animation: olxJetCrossRightV2 6.2s linear infinite both;
    }
    .olx-jet-attitude {
      position: relative;
      display: block;
      width: 100%;
      height: 100%;
      transform-origin: 50% 50%;
      transform: rotate(-6deg);
    }
    .olx-jet-hull {
      position: relative;
      z-index: 2;
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
      opacity: 1;
      filter: brightness(1.35) contrast(1.08)
              drop-shadow(0 5px 4px rgba(0, 0, 0, .7))
              drop-shadow(0 0 3px rgba(255, 217, 97, .75))
              drop-shadow(0 0 10px rgba(255, 183, 34, .22));
    }
    .olx-jet-engine {
      position: absolute;
      z-index: 1;
      right: 87%;
      width: 38%;
      height: 9%;
      border-radius: 100% 20% 20% 100%;
      transform-origin: right center;
      background: linear-gradient(90deg,
        rgba(255, 130, 0, 0), rgba(255, 166, 24, .24) 20%,
        rgba(255, 192, 63, .9) 61%, #ffe9aa 86%, #fffced);
      filter: blur(.7px) drop-shadow(0 0 5px rgba(255, 181, 42, .8));
      animation: olxJetExhaustV2 .65s ease-in-out infinite alternate;
    }
    .olx-jet-engine--a { top: 40.5%; }
    .olx-jet-engine--b { top: 51.5%; animation-delay: -.3s; }
    .olx-jet-vapor {
      position: absolute;
      z-index: 0;
      right: 91%;
      top: 28%;
      width: 145%;
      height: 44%;
      transform-origin: right center;
      filter: blur(3px);
      background:
        radial-gradient(ellipse at 83% 28%, rgba(250, 241, 214, .36), transparent 61%),
        radial-gradient(ellipse at 67% 75%, rgba(207, 207, 190, .27), transparent 60%),
        linear-gradient(90deg, transparent, rgba(255, 224, 145, .08));
      animation: olxJetVaporV2 2.4s ease-in-out infinite alternate;
    }
    .olx-jet-contrail {
      position: absolute;
      z-index: 0;
      right: 91%;
      top: 46%;
      width: 160%;
      height: 1px;
      background: linear-gradient(90deg, transparent,
        rgba(255, 230, 175, .14) 58%, rgba(255, 233, 169, .55));
      box-shadow: 0 0 7px rgba(255, 213, 116, .28),
                  0 10px 0 rgba(255, 222, 160, .10);
    }
    .olx-jet-flight--alpha {
      top: 10%;
      width: 200px;
      height: 120px;
      animation-duration: 6.2s;
      animation-delay: -.85s;
    }
    .olx-jet-flight--bravo {
      left: auto;
      right: 0;
      top: 38%;
      width: 170px;
      height: 102px;
      animation-name: olxJetCrossLeftV2;
      animation-duration: 7s;
      animation-delay: -1.15s;
    }
    .olx-jet-flight--bravo .olx-jet-attitude { transform: rotate(174deg); }
    .olx-jet-flight--charlie {
      top: 72%;
      width: 155px;
      height: 93px;
      animation-name: olxJetClimbRightV2;
      animation-duration: 6.8s;
      animation-delay: -4.9s;
    }
    .olx-jet-flight--charlie .olx-jet-attitude { transform: rotate(-12deg); }
    .olx-jet-flight--delta {
      left: auto;
      right: 0;
      top: 66%;
      width: 145px;
      height: 87px;
      animation-name: olxJetCrossLeftV2;
      animation-duration: 5.8s;
      animation-delay: -4.2s;
    }
    .olx-jet-flight--delta .olx-jet-attitude { transform: rotate(177deg); }
    @keyframes olxJetCrossRightV2 {
      0% { transform: translate3d(-260px, 12px, 0); opacity: 0; }
      6%, 94% { opacity: 1; }
      100% { transform: translate3d(calc(100vw + 260px), -10vh, 0); opacity: 0; }
    }
    @keyframes olxJetCrossLeftV2 {
      0% { transform: translate3d(240px, -10px, 0); opacity: 0; }
      6%, 94% { opacity: 1; }
      100% { transform: translate3d(calc(-100vw - 240px), 8vh, 0); opacity: 0; }
    }
    @keyframes olxJetClimbRightV2 {
      0% { transform: translate3d(-220px, 28px, 0); opacity: 0; }
      6%, 94% { opacity: .96; }
      100% { transform: translate3d(calc(100vw + 220px), -18vh, 0); opacity: 0; }
    }
    @keyframes olxJetExhaustV2 {
      from { transform: scaleX(.84) scaleY(.88); opacity: .8; }
      to { transform: scaleX(1.24) scaleY(1.10); opacity: 1; }
    }
    @keyframes olxJetVaporV2 {
      from { transform: scaleX(.9) scaleY(.85) translateY(-1px); opacity: .6; }
      to { transform: scaleX(1.14) scaleY(1.18) translateY(2px); opacity: .9; }
    }
    /* Mobile: two background flights pass beside the logo. Two slim near-field
       flights use the outer edges, so the banner cannot completely hide them.
       This overlay ignores clicks and does not change card sizes or spacing. */
    @media (max-width: 600px) {
      .olx-airspace--edge { z-index: 4; }
      .olx-jet-flight--alpha {
        top: 10px;
        bottom: auto;
        left: 0;
        right: auto;
        width: 120px;
        height: 72px;
        animation-name: olxJetMobileRightV2;
        animation-duration: 5.8s;
        animation-delay: -1.45s;
      }
      .olx-jet-flight--alpha .olx-jet-attitude { transform: rotate(-3deg); }
      .olx-jet-flight--bravo {
        top: 22px;
        bottom: auto;
        left: auto;
        right: 0;
        width: 110px;
        height: 66px;
        animation-name: olxJetMobileLeftV2;
        animation-duration: 6.8s;
        animation-delay: -1.4s;
      }
      .olx-jet-flight--bravo .olx-jet-attitude { transform: rotate(178deg); }
      .olx-jet-flight--charlie {
        top: auto;
        bottom: -112px;
        left: -16px;
        right: auto;
        width: 76px;
        height: 45.6px;
        animation-name: olxJetEdgeUpV2;
        animation-duration: 6.2s;
        animation-delay: -3.55s;
      }
      .olx-jet-flight--charlie .olx-jet-attitude { transform: rotate(-90deg); }
      .olx-jet-flight--delta {
        top: -112px;
        bottom: auto;
        left: auto;
        right: -16px;
        width: 76px;
        height: 45.6px;
        animation-name: olxJetEdgeDownV2;
        animation-duration: 6.9s;
        animation-delay: -4.7s;
      }
      .olx-jet-flight--delta .olx-jet-attitude { transform: rotate(90deg); }
      .olx-airspace--edge .olx-jet-vapor { width: 90%; opacity: .35; }
      .olx-airspace--edge .olx-jet-hull {
        filter: brightness(1.4) drop-shadow(0 2px 2px rgba(0,0,0,.8))
                drop-shadow(0 0 2px rgba(255,216,94,.65));
      }
      .olx-jet-vapor { width: 110%; }
      .olx-jet-contrail { width: 125%; }
    }
    @keyframes olxJetMobileRightV2 {
      0% { transform: translate3d(-148px, 0, 0); opacity: 0; }
      5%, 95% { opacity: 1; }
      100% { transform: translate3d(calc(100vw + 148px), -5px, 0); opacity: 0; }
    }
    @keyframes olxJetMobileLeftV2 {
      0% { transform: translate3d(138px, 0, 0); opacity: 0; }
      5%, 95% { opacity: 1; }
      100% { transform: translate3d(calc(-100vw - 138px), 5px, 0); opacity: 0; }
    }
    @keyframes olxJetEdgeUpV2 {
      0% { transform: translate3d(0, 0, 0); opacity: 0; }
      5%, 95% { opacity: .95; }
      100% { transform: translate3d(0, calc(-100vh - 240px), 0); opacity: 0; }
    }
    @keyframes olxJetEdgeDownV2 {
      0% { transform: translate3d(0, 0, 0); opacity: 0; }
      5%, 95% { opacity: .95; }
      100% { transform: translate3d(0, calc(100vh + 240px), 0); opacity: 0; }
    }
    /* OLX-JET-MOTION-FIX-V3
       Normal: keep the existing two-way flights.
       Reduced motion: slower flights, steady engine light, no static position
       override and no animation:none on the flight containers. */
    @media (prefers-reduced-motion: reduce) {
      .olx-jet-flight {
        animation-duration: 20s;
        animation-play-state: running;
      }
      .olx-jet-flight--alpha   { animation-delay: -5s; }
      .olx-jet-flight--bravo   { animation-delay: -5.5s; }
      .olx-jet-flight--charlie { animation-delay: -11.5s; }
      .olx-jet-flight--delta   { animation-delay: -14s; }
      .olx-jet-engine {
        animation: none;
        opacity: .55;
      }
      .olx-jet-vapor {
        animation: none;
        opacity: .30;
      }
      .olx-jet-contrail { opacity: .45; }
    }
    @media print { .olx-airspace { display: none; } }
